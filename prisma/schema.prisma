generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Doctor {
  id                  String            @id @default(uuid())
  fullName            String
  professionalTitle   String
  specialty           String
  shortBio            String
  biography           String
  profileImage        String?
  heroImage           String?
  yearsOfExperience   Int               @default(15)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  educations          Education[]
  experiences         Experience[]
  certificates        Certificate[]
  researchProjects    ResearchProject[]
  publications        Publication[]
  conferences         Conference[]
  articles            Article[]
  socialProfiles      SocialProfile[]
}

model Education {
  id              String   @id @default(uuid())
  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  degree          String
  field           String?
  institution     String
  country         String?
  startYear       String
  endYear         String?
  description     String?
  certificateFile String?
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Experience {
  id           String    @id @default(uuid())
  doctorId     String
  doctor       Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  position     String
  institution  String
  location     String?
  startDate    String
  endDate      String?
  isCurrent    Boolean   @default(false)
  description  String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Certificate {
  id                  String   @id @default(uuid())
  doctorId            String
  doctor              Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  title               String
  issuingOrganization String
  issueDate           String
  credentialId        String?
  verificationUrl     String?
  imageUrl            String?
  pdfUrl              String?
  description         String?
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ResearchArea {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String
  icon         String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ResearchProject {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  title       String
  slug        String   @unique
  description String
  objective   String?
  institution String
  startDate   String
  endDate     String?
  status      String   @default("ONGOING") // ONGOING, COMPLETED, PLANNED
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Publication {
  id              String               @id @default(uuid())
  doctorId        String
  doctor          Doctor               @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  title           String
  slug            String               @unique
  abstract        String
  journal         String
  publicationDate String
  publicationType String               @default("ORIGINAL_RESEARCH") // ORIGINAL_RESEARCH, REVIEW, CASE_REPORT, CONFERENCE_PAPER, OTHER
  doi             String?
  pdfUrl          String?
  featured        Boolean              @default(false)
  published       Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  authors         PublicationAuthor[]
  keywords        PublicationKeyword[]

  @@index([publicationDate])
  @@index([slug])
}

model PublicationAuthor {
  id            String      @id @default(uuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  name          String
  order         Int         @default(0)
}

model PublicationKeyword {
  id            String      @id @default(uuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  keyword       String
}

model Conference {
  id              String   @id @default(uuid())
  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  title           String
  slug            String   @unique
  description     String?
  location        String
  country         String?
  startDate       String
  endDate         String?
  role            String   @default("SPEAKER") // SPEAKER, MODERATOR, ATTENDEE, ORGANIZER, PANELIST
  topic           String
  presentationUrl String?
  registrationUrl String?
  imageUrl        String?
  isUpcoming      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([startDate])
}

model Article {
  id             String    @id @default(uuid())
  doctorId       String
  doctor         Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  title          String
  slug           String    @unique
  excerpt        String
  content        String
  coverImage     String?
  category       String    @default("PATIENT_EDUCATION") // PATIENT_EDUCATION, DIABETES, HYPERTENSION, PREVENTIVE_MEDICINE, INTERNAL_MEDICINE, HEALTHY_LIFESTYLE
  readingTime    String    @default("5 min")
  published      Boolean   @default(true)
  publishedAt    DateTime  @default(now())
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([slug])
  @@index([publishedAt])
}

model Clinic {
  id            String              @id @default(uuid())
  name          String
  city          String
  address       String
  phone         String
  whatsapp      String?
  email         String?
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?
  description   String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  services      ClinicService[]
  workingHours  ClinicWorkingHour[]
  appointments  Appointment[]

  @@index([city])
}

model ClinicService {
  id          String   @id @default(uuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  description String?
  duration    Int      @default(30) // in minutes
  price       Float?
  isActive    Boolean  @default(true)
}

model ClinicWorkingHour {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String   // e.g., "17:00"
  endTime   String   // e.g., "21:00"
  isClosed  Boolean  @default(false)
}

model Appointment {
  id               String   @id @default(uuid())
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  serviceId        String
  patientName      String
  patientPhone     String
  patientEmail     String
  appointmentDate  String   // YYYY-MM-DD
  startTime        String   // HH:MM format
  endTime          String?
  status           String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  notes            String?
  bookingReference String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([appointmentDate])
  @@index([status])
  @@index([bookingReference])
}

model SocialProfile {
  id           String   @id @default(uuid())
  doctorId     String
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  platform     String
  profileName  String?
  url          String
  icon         String?
  category     String   @default("SOCIAL") // SOCIAL, ACADEMIC
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW") // NEW, READ, REPLIED, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
